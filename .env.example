# No credentials or patient records are distributed with this repository.
# Copy to .env locally; never commit the resulting .env file.
HCC_API_KEY=
# Input and output paths must refer to locally authorized data.
HCC_DATA_DIR=data/test_json
HCC_RESULT_DIR=outputs/model_outputs
HCC_GROUND_TRUTH=data/outcomes.csv
HCC_EXPLANATION_DIR=outputs/model_outputs
HCC_PREDICTIONS_CSV=outputs/model_outputs/ground_truth_with_predictions.csv
HCC_METRICS_WORKBOOK=data/model_test_results.xlsx
# Set HCC_OUTPUT_DIR separately for each run to avoid mixing configurations.
# DeepSeek V4 preview scripts retain the original environment-driven settings.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=
